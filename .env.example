# Application Settings
APP_NAME="DUT Gateway & Vault API"
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
DB_ECHO=false

# Cache & Task Queue (Redis)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6379/0

# Dynamic Vault Encryption (AES-256-GCM Master Key - change in production!)
VAULT_MASTER_KEY=default-master-key-must-be-changed-in-production-32b

# Apache APISIX Gateway
APISIX_ADMIN_URL=http://localhost:9180
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1
APISIX_GATEWAY_URL=http://localhost:9080
APISIX_GATEWAY_SSL_URL=https://localhost:9443
APISIX_BACKEND_HOST=host.docker.internal
APISIX_BACKEND_PORT=8000

# Security & Authentication (JWT & DUT-AI SSO)
JWT_SECRET_KEY=supersecretjwtkeychangemeinproduction32char
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SSO_DUTAI_BASE_URL=https://manage.dutai.io.vn

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# PyPI SDK Publishing (optional, set real token only in .env)
PYPI_TOKEN=
